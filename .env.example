# ============================================================
# BIYANI AI COUNSELOR — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to GitHub.
# ============================================================

# --- Qdrant Cloud (Vector Database) ---
QDRANT_URL=https://your-cluster.us-east-1-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=biyani_clean_v2

# --- NVIDIA NIM (Embeddings + Reranker) ---
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- Groq (Primary LLM — Llama 3.3 70B) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Google Gemini (Fallback LLM) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenRouter (Last Fallback LLM) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Upstash Redis (Cache + Analytics) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
CACHE_ENABLED=True

# --- App Settings ---
APP_NAME=Biyani AI Counselor
APP_ENV=production
DEBUG=False

# --- Admin Security (CHANGE THIS — use a strong random password) ---
ADMIN_TOKEN=your_strong_admin_password_here

# --- HuggingFace (Optional) ---
HF_TOKEN=your_hf_token_here
