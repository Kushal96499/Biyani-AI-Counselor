# ============================================================
# BIYANI AI COUNSELOR - .gitignore (Production Safe)
# ============================================================

# --- SECRETS (NEVER COMMIT) ---
.env
.env.local
.env.production
*.key
*.pem

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.Python
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/

# --- Logs (Generated at runtime, not source) ---
logs/
*.log

# --- Local Data & Dumps (Large files, indexed to cloud) ---
data/
models/

# --- Scratch / Dev Scripts (Not production code) ---
scratch/

# --- Reports & Docs (Local only) ---
Biyani_AI_Master_Report_v2.txt
Biyani_AI_Project_Update.md

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
