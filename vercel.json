{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "500mb" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "TRANSFORMERS_CACHE": "/tmp",
    "SENTENCE_TRANSFORMERS_HOME": "/tmp",
    "PYTHON_VERSION": "3.12"
  }
}